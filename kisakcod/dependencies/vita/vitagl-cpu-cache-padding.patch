+// The compiler buffer may include up to three trailing alignment bytes.
+// GXM declares the semantic program size; both lengths are checksum protected.
+// Admit only an exact payload or its four-byte rounded size, never arbitrary
+// trailing data. Validate the declared extent before asking GXM to inspect it.
+static GLboolean cod4_cache_program_valid(const void *program, size_t stored) {
+    unsigned start=sceKernelGetProcessTimeLow();
+    if(!program || stored<64 || stored>4u*1024u*1024u)return GL_FALSE;
+    const size_t declared=sceGxmProgramGetSize(program);
+    if(declared<64 || declared>stored
+        || (stored!=declared && stored!=((declared+3u)&~(size_t)3u))) {
+        cod4_cache_event(8,start,(unsigned)declared);return GL_FALSE;
+    }
+    if(sceGxmProgramCheck(program)!=0) {
+        cod4_cache_event(9,start,0);return GL_FALSE;
+    }
+    if(stored!=declared)cod4_cache_event(7,start,(unsigned)(stored-declared));
+    return GL_TRUE;
 }
