+// CODVIT cache envelope. Payload equations and compiler options are unchanged.
+// A cache hit is admitted only after exact length, format, checksum and layout
+// validation. The application supplies its source/compiler compatibility root.
+static GLboolean cod4_cache_enabled = GL_FALSE;
+extern void vglCod4CacheEvent(unsigned event, unsigned elapsed_us, unsigned bytes) __attribute__((weak));
+void vglCod4CacheEnable(GLboolean enabled) { cod4_cache_enabled = enabled; }
+static void cod4_cache_event(unsigned event, unsigned start, unsigned bytes) {
+    if (vglCod4CacheEvent) vglCod4CacheEvent(event, sceKernelGetProcessTimeLow() - start, bytes);
+}
+typedef struct {uint32_t magic,version,bytes,kind;uint64_t checksum;} cod4_cache_header;
+static void cod4_cache_reject(const char *path) {
+    // Invalid data is not needed for recovery. Remove this single cache entry;
+    // no content, source asset, or other title's cache is ever selected here.
+    sceIoRemove(path);
+}
+void *vglCod4CacheRead(const char *path, size_t *bytes, unsigned kind) {
+    unsigned start = sceKernelGetProcessTimeLow();
+    *bytes = 0;
+    if (!cod4_cache_enabled) {cod4_cache_event(0,start,0);return NULL;}
+    SceUID file = sceIoOpen(path,SCE_O_RDONLY,0);
+    if (file < 0) {cod4_cache_event(2,start,0);return NULL;}
+    cod4_cache_header header;
+    SceOff length = sceIoLseek(file,0,SCE_SEEK_END);
+    sceIoLseek(file,0,SCE_SEEK_SET);
+    GLboolean valid = sceIoRead(file,&header,sizeof(header)) == sizeof(header)
+        && header.magic == 0x31435643 && header.version == 1 && header.kind == kind
+        && header.bytes >= 16 && header.bytes <= 4*1024*1024
+        && length == sizeof(header) + (uint64_t)header.bytes;
+    void *data = valid ? vglMalloc(header.bytes) : NULL;
+    if (data) valid = sceIoRead(file,data,header.bytes) == header.bytes
+        && VITAGL_XXH3_64bits(data,header.bytes) == header.checksum;
+    else valid = GL_FALSE;
+    sceIoClose(file);
+    if (valid && kind == 0) valid = header.bytes >= 64
+        && sceGxmProgramGetSize(data) == header.bytes && sceGxmProgramCheck(data) == 0;
+    if (!valid) {
+        if (data) vgl_free(data);
+        cod4_cache_reject(path);cod4_cache_event(3,start,0);return NULL;
+    }
+    *bytes=header.bytes;cod4_cache_event(1,start,header.bytes);return data;
+}
+void vglCod4CacheWrite(const char *path,const void *data,size_t bytes,unsigned kind) {
+    unsigned start=sceKernelGetProcessTimeLow();
+    if (!cod4_cache_enabled) return;
+    if (!data || bytes<16 || bytes>4*1024*1024) {cod4_cache_event(5,start,0);return;}
+    char pending[288];
+    if (snprintf(pending,sizeof(pending),"%s.pending",path) >= sizeof(pending)) {cod4_cache_event(5,start,0);return;}
+    cod4_cache_header header={0x31435643,1,(uint32_t)bytes,kind,VITAGL_XXH3_64bits(data,bytes)};
+    SceUID file=sceIoOpen(pending,SCE_O_CREAT|SCE_O_WRONLY|SCE_O_TRUNC,0777);
+    GLboolean valid=file>=0 && sceIoWrite(file,&header,sizeof(header))==sizeof(header)
+        && sceIoWrite(file,data,bytes)==bytes && sceIoSyncByFd(file,0)>=0;
+    if(file>=0 && sceIoClose(file)<0) valid=GL_FALSE;
+    if(valid) valid=sceIoRename(pending,path)>=0;
+    if(!valid)sceIoRemove(pending);
+    cod4_cache_event(valid?4:5,start,bytes);
+}
 
